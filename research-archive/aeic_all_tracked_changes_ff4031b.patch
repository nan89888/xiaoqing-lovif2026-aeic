+class ImageDirectoryDataset(Dataset):
+    def __init__(self, root, transform=None, min_size=None):
+        self.root = Path(root)
+        if not self.root.is_dir():
+            raise ValueError(f"Image directory does not exist: {self.root}")
+        patterns = ("*.png", "*.jpg", "*.jpeg", "*.PNG", "*.JPG", "*.JPEG")
+        self.paths = sorted({p for pattern in patterns for p in self.root.glob(pattern)})
+        if len(self.paths) == 0:
+            raise ValueError(f"No images found in: {self.root}")
+        if min_size is not None:
+            kept = []
+            for path in self.paths:
+                with Image.open(path) as image:
+                    width, height = image.size
+                if width >= min_size and height >= min_size:
+                    kept.append(path)
+            self.paths = kept
+            if len(self.paths) == 0:
+                raise ValueError(f"No images at least {min_size}x{min_size} found in: {self.root}")
+        self.transform = transform
+
+    def __getitem__(self, index):
+        image = Image.open(self.paths[index]).convert("RGB")
+        if self.transform:
+            image = self.transform(image)
+        return image
+
+    def __len__(self):
+        return len(self.paths)
